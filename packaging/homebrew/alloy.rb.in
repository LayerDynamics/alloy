# Generated by scripts/homebrew/formula.mjs from the reviewed source commit.
class Alloy < Formula
  desc "Apple Silicon agent harness with unified CPU/Metal inference"
  homepage "https://github.com/LayerDynamics/alloy"
  url "https://github.com/LayerDynamics/alloy.git", revision: "@@SOURCE_COMMIT@@"
  version "@@VERSION@@"
@@REVISION_LINE@@  license "Apache-2.0"

  depends_on "cmake" => :build
  depends_on xcode: ["15.0", :build]
  depends_on arch: :arm64
  depends_on macos: :sonoma

  # Private, checksum-pinned runtime: the user's shell Node is unchanged.
  resource "node-runtime" do
    url "@@NODE_URL@@"
    sha256 "@@NODE_SHA256@@"
  end

  # Build-only toolchain; no rustup installation or user configuration changes.
  resource "rust-toolchain" do
    url "@@RUST_URL@@"
    sha256 "@@RUST_SHA256@@"
  end

  def prepare_toolchains
    node_root = buildpath/"target/homebrew/node"
    rust_root = buildpath/"target/homebrew/rust"
    resource("node-runtime").stage(node_root) unless (node_root/"bin/node").exist?
    unless (rust_root/"bin/cargo").exist?
      resource("rust-toolchain").stage do
        system "./install.sh", "--prefix=#{rust_root}", "--disable-ldconfig",
               "--components=rustc,cargo,rust-std-aarch64-apple-darwin"
      end
    end
    ENV.prepend_path "PATH", rust_root/"bin"
    ENV.prepend_path "PATH", node_root/"bin"
    ENV["RUSTC"] = (rust_root/"bin/rustc").to_s
    ENV["RUSTDOC"] = (rust_root/"bin/rustdoc").to_s
    ENV["RUSTC_WRAPPER"] = nil
    ENV["CARGO_HOME"] = (HOMEBREW_CACHE/"alloy-cargo").to_s
    ENV["CARGO_TARGET_DIR"] = (buildpath/"target/homebrew/cargo-target").to_s
    # Respect Homebrew's configured parallelism, with a bounded cap to avoid
    # multiplying Cargo and native compiler work without limit.
    build_jobs = [[ENV.make_jobs, 1].max, 4].min.to_s
    ENV["CARGO_BUILD_JOBS"] = build_jobs
    ENV["CMAKE_BUILD_PARALLEL_LEVEL"] = build_jobs
    # Retain dependencies, not compiled package outputs. Locked offline fetch
    # avoids registry requests on a complete cache; misses use bounded retries.
    ENV["CARGO_HTTP_MULTIPLEXING"] = "false"
    ENV["CARGO_NET_RETRY"] = "3"
    ENV["CARGO_HTTP_TIMEOUT"] = "30"
    ENV["npm_config_cache"] = (buildpath/"target/homebrew/npm-cache").to_s
    node_root
  end

  # The network-enabled fetch phase fills the dedicated dependency cache.
  def fetch
    node_root = prepare_toolchains
    unless quiet_system "cargo", "fetch", "--locked", "--offline", "--target", "aarch64-apple-darwin"
      system "cargo", "fetch", "--locked", "--target", "aarch64-apple-darwin"
    end
    system node_root/"bin/node", node_root/"lib/node_modules/npm/bin/npm-cli.js",
           "ci", "--prefix", "ts/cli", "--ignore-scripts", "--no-audit", "--no-fund"
  end

  def install
    node_root = prepare_toolchains
    system node_root/"bin/node", "scripts/homebrew/package.mjs",
           "--prefix", prefix, "--opt-prefix", opt_prefix,
           "--node-runtime", node_root, "--source-commit", "@@SOURCE_COMMIT@@", "--offline"
  end

  def caveats
    <<~EOS
      Start Alloy with: alloy start
      Then use alloy chat or alloy monitor in another terminal.
      The first start needs a local model or an explicit download choice.

      This development preview is built from a pinned source commit.
      CPU and Metal share unified memory; monitoring needs no sudo.
      No daemon or model download is started by installation.
      Settings, sessions, and model/cache data stay outside the Cellar.

      After an upgrade, stop the old foreground daemon with Ctrl+C, then
      run alloy start again. A compatible running daemon is otherwise reused.
    EOS
  end

  test do
    ENV["ALLOY_CONFIG_DIR"] = (testpath/"config").to_s
    ENV["ALLOYD"] = nil
    socket_path = (testpath/"config/alloyd.sock").to_s
    assert_operator socket_path.bytesize, :<, 104,
                    "Homebrew test socket exceeds macOS's path limit; use a short HOMEBREW_TEMP: #{socket_path}"
    alloy = (bin/"alloy").to_s.shellescape
    alloyd = (bin/"alloyd").to_s.shellescape
    assert_equal "alloy @@VERSION@@", shell_output("#{alloy} --version").strip
    assert_equal "alloyd @@VERSION@@", shell_output("#{alloyd} --version").strip
    assert_path_exists libexec/"native/mlx.metallib"
    native = JSON.parse(shell_output("#{alloyd} --check-native"))
    assert_equal true, native.fetch("ok")
    assert_equal "passed", native.fetch("cpu").fetch("status")
    assert_equal "passed", native.fetch("metal").fetch("status")
    assert_equal "passed", native.fetch("shared_arrays").fetch("status")
    doctor = JSON.parse(shell_output("#{alloy} doctor --json", 1))
    assert_equal "setup_required", doctor.fetch("readiness"), JSON.pretty_generate(doctor)
    assert_equal "binary", doctor.fetch("launch").fetch("kind")
    assert_equal (opt_libexec/"native/alloyd").to_s, doctor.fetch("launch").fetch("command")
    system libexec/"cli/dist/native/alloy-metrics", "--self-test"
    monitor = JSON.parse(shell_output("#{alloy} monitor --once --json"))
    assert_equal 1, monitor.fetch("schema_version")
    assert_equal "darwin", monitor.fetch("host").fetch("platform")
    refute_predicate testpath/"config/settings.json", :exist?
  end
end
