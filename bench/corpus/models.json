    "artifact_hash_contract": {
        "algorithm": "sha256",
        "file_hashes": "Hash the downloaded file bytes, not Git LFS pointer files.",
        "aggregate": "Sort the files array by path using UTF-8 byte order. For each entry, append the UTF-8 path, a NUL byte, the lowercase hexadecimal SHA-256 of that file, and another NUL byte. Hash the concatenated bytes with SHA-256.",
        "scope": "Every file required to load, tokenize, render chat templates, and run the pinned model. Record the exact file set in each artifact's files array."
    },
    "resolution_procedure": {
        "steps": [
            "Run on the physical 36 GB Mac: hf download <repository> --revision <resolved-sha> for each artifact, pinning the current main commit SHA as the revision.",
            "Record every file (including tokenizer.json, generation_config.json, chat templates if present) in the artifact's files array with its individual sha256.",
            "Compute the aggregate hash per artifact_hash_contract and record it as artifact.sha256.",
            "Read quantization/group_size from each repo's config.json; if it differs from the values below, update this file and the manifest.",
            "For llama.cpp and ollama, resolve the comparison artifact repos/tags listed under comparison_artifacts, download, hash, and set verified to true. Report any that cannot meet the same-checkpoint policy as unsupported cases.",
            "Set status to frozen and fill verification.verified_at with the UTC date once every profile is green."
        ],
        "record": "bench/corpus/README.md"
    },
    "comparison_policy": {
        "same_source_checkpoint_required": true,
        "same_nominal_bit_width_required": true,
        "quantization_recipe_must_be_recorded": true,
        "nominal_bit_width_alone_proves_equivalence": false,
        "backend_artifacts_must_be_pinned": true,
        "unavailable_comparisons_must_be_reported": true
    },
